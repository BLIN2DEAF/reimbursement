# 图片识别模型配置（由使用者向自己的模型服务商获取）
MIMO_API_KEY=
MIMO_BASE_URL=
MIMO_MODEL=

# 本地服务（默认仅允许本机访问，避免报销材料暴露到局域网）
HOST=127.0.0.1
PORT=8080
SESSION_TTL_MS=28800000
# 自动填单出错时保留故障 BIP 浏览器，便于查看现场（默认 10 分钟）
ERROR_BROWSER_TTL_MS=600000

# 用友 BIP 报销系统账号（登录地址已内置在发行版）
BIP_USERNAME=
BIP_PASSWORD=

# 个人收款信息与补助标准
BANK_ACCOUNT=
MEAL_RATE=100
TRANSPORT_RATE=80
