# Mimo Vision API 配置
MIMO_API_KEY=你的MIMO_API密钥
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_MODEL=mimo2.5

# 用友BIP 报销系统配置
BIP_URL=https://fsc.sdhsg.com/yonbip/resources/uap/rbac/login/main/index.html
BIP_USERNAME=你的BIP账号
BIP_PASSWORD=你的BIP密码

# 报销默认信息
BANK_ACCOUNT=你的银行卡号
PAYEE_NAME=你的姓名
PAYMENT_BANK=中国农业银行
ORG_NAME=你的公司全称
BUDGET_ITEM=预算项目名称
MEAL_RATE=100
TRANSPORT_RATE=80
