{
   "name": "reimbursement-app",
   "version": "1.0.0",
   "type": "module",
   "scripts": {
      "dev": "tsx src/server.ts",
      "start": "tsx src/server.ts",
      "typecheck": "tsc --noEmit",
      "test": "tsx --test tests/core.test.ts",
      "check": "npm run typecheck && npm test",
      "check:share": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/audit-share.ps1",
      "package:share": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-share.ps1",
      "package:offline": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-offline.ps1",
      "check:mimo": "tsx scripts/check-mimo.ts",
      "check:bip-mapping": "tsx scripts/check-bip-mapping.ts"
   },
   "dependencies": {
      "@anthropic-ai/sdk": "^0.115.0",
      "dotenv": "^16.4.5",
      "express": "^4.21.0",
      "multer": "^1.4.5-lts.1",
      "openai": "^4.67.0",
      "pdf-parse": "^1.1.1",
      "pdfjs-dist": "4.10.38",
      "playwright": "^1.48.0",
      "sharp": "^0.34.5",
      "uuid": "^10.0.0",
      "ws": "^8.18.0"
   },
   "devDependencies": {
      "@types/express": "^5.0.0",
      "@types/multer": "^1.4.12",
      "@types/node": "^22.0.0",
      "@types/uuid": "^10.0.0",
      "@types/ws": "^8.5.12",
      "tsx": "^4.19.0",
      "typescript": "^5.6.0"
   }
}
